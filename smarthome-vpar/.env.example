# Copia este archivo como .env y ajusta los valores. Nunca subas .env a GitHub.
PORT=3000
# Carpeta donde se guardan la base de datos (store.db) y las fotografías (uploads/).
DATA_DIR=./data
# En producción (detrás de HTTPS) activa cookies seguras:
# NODE_ENV=production
# Administrador inicial opcional (si no se define, usa /admin/setup con el código que aparece en la consola):
# ADMIN_USER=admin
# ADMIN_PASSWORD=UnaClaveLarga2026
# Cargar datos de demostración en una base de datos vacía (1 = sí, 0 = no):
SEED_DEMO=1
# Tamaño máximo por imagen en MB:
MAX_UPLOAD_MB=10
