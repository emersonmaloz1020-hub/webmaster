<article class="card product-card">
  <a href="/producto/<%= p.slug %>" class="product-media" tabindex="-1" aria-hidden="true">
    <% if (p.image) { %>
      <img src="<%= p.image.path %>" alt="<%= p.image.alt || p.name %>" loading="lazy" width="400" height="400">
    <% } else { %>
      <span class="no-image"><%- icon('camera', 48) %></span>
    <% } %>
    <span class="badges">
      <% if (p.pricing.onSale) { %><span class="badge badge-sale">-<%= p.pricing.discount %>%</span><% } else if (p.is_offer) { %><span class="badge badge-sale">Oferta</span><% } %>
      <% if (p.is_new) { %><span class="badge badge-new">Nuevo</span><% } %>
      <% if (p.featured) { %><span class="badge badge-feat">Destacado</span><% } %>
      <% if (p.is_demo) { %><span class="badge badge-demo">Ejemplo</span><% } %>
    </span>
  </a>
  <div class="product-body">
    <% if (p.category) { %><span class="product-cat"><%= p.category.name %></span><% } %>
    <h3 class="product-title"><a href="/producto/<%= p.slug %>"><%= p.name %></a></h3>
    <div class="price-row">
      <span class="price"><%= h.formatCOP(p.pricing.current) %></span>
      <% if (p.pricing.previous) { %><s class="price-old"><%= h.formatCOP(p.pricing.previous) %></s><% } %>
    </div>
    <span class="avail avail-<%= p.avail.css %>"><span class="dot"></span><%= p.avail.label %></span>
    <div class="card-actions">
      <a class="btn btn-ghost btn-sm" href="/producto/<%= p.slug %>">Ver detalles</a>
      <% if (cartEnabled && p.avail.key !== 'agotado') { %>
        <button type="button" class="btn btn-primary btn-sm" data-add-cart="<%= p.id %>" data-name="<%= p.name %>"><%- icon('cart', 16) %> Agregar</button>
      <% } else if (waConfigured) { %>
        <a class="btn btn-wa btn-sm" href="<%= waProduct(p) %>" target="_blank" rel="noopener"><%- icon('whatsapp', 16) %> Consultar</a>
      <% } %>
    </div>
  </div>
</article>
