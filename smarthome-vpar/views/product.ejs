<%- include('partials/head') %>
<%- include('partials/header') %>
<div class="container">
  <nav class="breadcrumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a><span>/</span><a href="/catalogo">Catálogo</a>
    <% if (p.category) { %><span>/</span><a href="/categoria/<%= p.category.slug %>"><%= p.category.name %></a><% } %>
    <span>/</span><span aria-current="page"><%= p.name %></span>
  </nav>

  <% if (!p.active) { %><div class="notice notice-warn">Este producto está desactivado: solo lo ves porque iniciaste sesión como administrador.</div><% } %>
  <% if (p.is_demo) { %><div class="notice notice-info"><%- icon('star', 16) %> Producto de demostración: su nombre, precio e imágenes son ejemplos.</div><% } %>

  <article class="product-detail">
    <div class="gallery" data-gallery>
      <div class="gallery-main">
        <% if (p.images.length) { %>
          <button type="button" class="gallery-zoom" data-open-lightbox="0" aria-label="Ampliar imagen">
            <img src="<%= p.images[0].path %>" alt="<%= p.images[0].alt || p.name %>" data-main-image width="800" height="800">
            <span class="zoom-hint"><%- icon('zoom', 18) %> Ampliar</span>
          </button>
        <% } else { %>
          <div class="no-image big"><%- icon('camera', 64) %><p>Imagen no disponible</p></div>
        <% } %>
        <span class="badges">
          <% if (p.pricing.onSale) { %><span class="badge badge-sale">-<%= p.pricing.discount %>%</span><% } else if (p.is_offer) { %><span class="badge badge-sale">Oferta</span><% } %>
          <% if (p.is_new) { %><span class="badge badge-new">Nuevo</span><% } %>
          <% if (p.is_demo) { %><span class="badge badge-demo">Ejemplo</span><% } %>
        </span>
      </div>
      <% if (p.images.length > 1) { %>
        <div class="gallery-thumbs" role="list">
          <% p.images.forEach((img, i) => { %>
            <button type="button" role="listitem" class="thumb <%= i === 0 ? 'active' : '' %>" data-thumb="<%= i %>" data-src="<%= img.path %>" data-alt="<%= img.alt || p.name %>" aria-label="Ver imagen <%= i + 1 %> de <%= p.images.length %>">
              <img src="<%= img.path %>" alt="" loading="lazy" width="96" height="96">
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="product-info">
      <% if (p.categories.length) { %>
        <div class="product-cats"><% p.categories.forEach((c) => { %><a href="/categoria/<%= c.slug %>" class="chip chip-sm"><%= c.name %></a><% }) %></div>
      <% } %>
      <h1><%= p.name %></h1>
      <% if (p.brand || p.model) { %>
        <p class="brand-model"><% if (p.brand) { %>Marca: <strong><%= p.brand %></strong><% } %><% if (p.brand && p.model) { %> · <% } %><% if (p.model) { %>Modelo: <strong><%= p.model %></strong><% } %></p>
      <% } %>
      <% if (p.short_description) { %><p class="lead"><%= p.short_description %></p><% } %>

      <div class="price-box">
        <div class="price-row big">
          <span class="price"><%= h.formatCOP(p.pricing.current) %></span>
          <% if (p.pricing.previous) { %><s class="price-old"><%= h.formatCOP(p.pricing.previous) %></s><span class="badge badge-sale">Ahorras <%= h.formatCOP(p.pricing.previous - p.pricing.current) %></span><% } %>
        </div>
        <% if (p.pricing.onSale && p.promo_ends) { %><p class="muted small">Precio promocional válido hasta el <%= p.promo_ends.split('-').reverse().join('/') %>.</p><% } %>
        <span class="avail avail-<%= p.avail.css %>"><span class="dot"></span><%= p.avail.label %><% if (p.stock !== null && p.stock > 0 && p.stock <= 5) { %> · quedan <%= p.stock %><% } %></span>
      </div>

      <div class="buy-actions">
        <% if (cartEnabled && p.avail.key !== 'agotado') { %>
          <div class="qty" data-qty>
            <button type="button" data-qty-minus aria-label="Disminuir cantidad">−</button>
            <input type="number" min="1" max="99" value="1" aria-label="Cantidad" data-qty-input>
            <button type="button" data-qty-plus aria-label="Aumentar cantidad">+</button>
          </div>
          <button type="button" class="btn btn-primary btn-lg" data-add-cart="<%= p.id %>" data-name="<%= p.name %>" data-with-qty><%- icon('cart', 20) %> Agregar al carrito</button>
        <% } %>
        <% if (waConfigured) { %>
          <a class="btn btn-wa btn-lg" href="<%= waProduct(p) %>" target="_blank" rel="noopener"><%- icon('whatsapp', 20) %> <%= p.avail.key === 'agotado' ? 'Consultar disponibilidad' : 'Comprar o consultar por WhatsApp' %></a>
        <% } else if (!cartEnabled) { %>
          <a class="btn btn-ghost btn-lg" href="/contacto"><%- icon('chat', 20) %> Ver datos de contacto</a>
        <% } %>
      </div>

      <% if (p.connectivityList.length || p.compatibilityList.length) { %>
      <ul class="feature-pills">
        <% p.connectivityList.forEach((c) => { %><li><%- icon(/bluetooth/i.test(c) ? 'bolt' : /zigbee/i.test(c) ? 'sensor' : /ethernet/i.test(c) ? 'router' : 'wifi', 16) %> <%= c %></li><% }) %>
        <% p.compatibilityList.forEach((c) => { %><li><%- icon('mic', 16) %> Compatible con <%= c %></li><% }) %>
      </ul>
      <% } %>
    </div>
  </article>

  <div class="product-tabs">
    <section class="detail-block">
      <h2>Descripción</h2>
      <div class="prose"><% p.description.split(/\n{2,}/).forEach((para) => { %><p><%= para %></p><% }) %></div>
    </section>
    <% if (specs.length || p.brand || p.model || p.connectivityList.length) { %>
    <section class="detail-block">
      <h2>Características técnicas</h2>
      <table class="spec-table">
        <tbody>
          <% if (p.brand) { %><tr><th scope="row">Marca</th><td><%= p.brand %></td></tr><% } %>
          <% if (p.model) { %><tr><th scope="row">Modelo</th><td><%= p.model %></td></tr><% } %>
          <% if (p.connectivityList.length) { %><tr><th scope="row">Conectividad</th><td><%= p.connectivityList.join(', ') %></td></tr><% } %>
          <% if (p.compatibilityList.length) { %><tr><th scope="row">Compatibilidad</th><td><%= p.compatibilityList.join(', ') %></td></tr><% } %>
          <% specs.forEach((sp) => { %><tr><th scope="row"><%= sp.label %></th><td><%= sp.value %></td></tr><% }) %>
        </tbody>
      </table>
    </section>
    <% } %>
    <% if (p.box_contents) { %>
    <section class="detail-block">
      <h2>Contenido de la caja</h2>
      <ul class="check-list"><% h.splitList(p.box_contents.replace(/,/g, '\n')).forEach((it) => { %><li><%- icon('check', 16) %> <%= it %></li><% }) %></ul>
    </section>
    <% } %>
  </div>

  <% if (related.length) { %>
  <section class="section">
    <div class="section-head"><div><h2>Productos relacionados</h2></div></div>
    <div class="product-grid">
      <% related.forEach((rp) => { %><%- include('partials/product-card', { p: rp }) %><% }) %>
    </div>
  </section>
  <% } %>
</div>

<% if (p.images.length) { %>
<div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Galería de imágenes">
  <button type="button" class="lb-close" data-lb-close aria-label="Cerrar"><%- icon('close', 26) %></button>
  <% if (p.images.length > 1) { %>
    <button type="button" class="lb-prev" data-lb-prev aria-label="Imagen anterior"><%- icon('left', 30) %></button>
    <button type="button" class="lb-next" data-lb-next aria-label="Imagen siguiente"><%- icon('right', 30) %></button>
  <% } %>
  <figure>
    <img src="" alt="" data-lb-image>
    <figcaption data-lb-caption></figcaption>
  </figure>
  <script type="application/json" data-lb-images><%- JSON.stringify(p.images.map((i) => ({ src: i.path, alt: i.alt || p.name }))).replace(/</g, '\\u003c') %></script>
</div>
<% } %>

<% if (cartEnabled || waConfigured) { %>
<div class="mobile-buy">
  <div><span class="price"><%= h.formatCOP(p.pricing.current) %></span><span class="avail avail-<%= p.avail.css %>"><span class="dot"></span><%= p.avail.label %></span></div>
  <% if (cartEnabled && p.avail.key !== 'agotado') { %>
    <button type="button" class="btn btn-primary" data-add-cart="<%= p.id %>" data-name="<%= p.name %>"><%- icon('cart', 18) %> Agregar</button>
  <% } else if (waConfigured) { %>
    <a class="btn btn-wa" href="<%= waProduct(p) %>" target="_blank" rel="noopener"><%- icon('whatsapp', 18) %> Consultar</a>
  <% } %>
</div>
<% } %>

<%- include('partials/footer') %>
